# Conexión a YugabyteDB (YSQL puerto 5433) o PostgreSQL (puerto 5432)
# Ejemplo YugabyteDB: postgres://yugabyte:yugabyte@127.0.0.1:5433/yugabyte
# Ejemplo PostgreSQL: postgres://postgres:postgres@127.0.0.1:5432/notiz
DATABASE_URL=postgres://yugabyte:yugabyte@127.0.0.1:5433/notiz

# Clave secreta para firmar los JWT (mínimo 16 caracteres)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_seguro_2026
JWT_EXPIRATION_HOURS=168

# Opcional: ID de cliente de Google OAuth2 para validar id_token en POST /api/auth/google
GOOGLE_CLIENT_ID=

# Servidor HTTP
HOST=0.0.0.0
PORT=3000

# Tamaño máximo por imagen adjunta en bytes (por defecto 10 MB)
MAX_IMAGE_SIZE_BYTES=10485760

